---
import '../styles/global.css';
import WorldEngineCanvas from '../components/WorldEngineCanvas.astro';
import { getRepositories } from '../utils/github';

const repos = await getRepositories();
const repoCount = repos.length || 0;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>DevPro Experience Platform</title>
	</head>
	<body>
		<main id="dxp-root">
            <!-- Background WebGL Layer -->
            <WorldEngineCanvas />
            
            <!-- Foreground UI Layer -->
            <div class="os-ui">
                <header class="os-header">
                    <div class="logo-container">
                        <div class="logo-dot"></div>
                        <div class="logo-text">DXP Core</div>
                    </div>
                    <div class="system-status">
                        <span class="status-indicator">●</span> SYSTEM ONLINE | BUILD v0.2.0-alpha
                    </div>
                </header>

                <div class="os-main">
                    <!-- Left Sidebar -->
                    <aside class="glass-panel" style="animation-delay: 0.1s">
                        <div class="panel-title">System Modules</div>
                        <ul class="nav-list">
                            <li class="nav-item active">Overview</li>
                            <li class="nav-item">Reality Engine</li>
                            <li class="nav-item">World Engine</li>
                            <li class="nav-item">Animation</li>
                            <li class="nav-item">Registry</li>
                            <li class="nav-item">Plugins</li>
                        </ul>

                        <div class="panel-title" style="margin-top: 2rem;">Active Nodes</div>
                        <div class="nav-list" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;">
                            <div style="color: var(--accent);">> cluster-01 [OK]</div>
                            <div style="color: var(--accent);">> mem-cache [OK]</div>
                            <div style="color: #8892b0;">> proxy-net [IDLE]</div>
                        </div>
                        
                        <div class="panel-title" style="margin-top: 2rem;">GitHub Integration</div>
                        <div class="nav-list" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;">
                            <div style="color: var(--accent);">> Discovered Repos: {repoCount}</div>
                        </div>
                    </aside>

                    <!-- Center Display -->
                    <section class="center-content">
                        <h1 class="hero-title">ENTERPRISE<br/>EXPERIENCE PLATFORM</h1>
                        <p class="hero-subtitle">The definitive foundation for scalable, high-performance web environments. Harnessing the power of the World Engine and Reality protocols.</p>
                        
                        {repoCount > 0 && (
                            <div style="margin-top: 2rem; background: rgba(0,0,0,0.4); padding: 1rem; border-radius: 8px; max-width: 600px;">
                                <h3 style="color: var(--accent); font-family: 'JetBrains Mono', monospace; margin-bottom: 0.5rem; font-size: 1rem;">>>> LIVE SHOWCASE DATA</h3>
                                <ul style="list-style: none; padding: 0; margin: 0; text-align: left;">
                                    {repos.slice(0, 3).map((repo: any) => (
                                        <li style="margin-bottom: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem;">
                                            <span style="color: #fff;">{repo.name}</span> 
                                            {repo.language && <span style="color: #8892b0;"> [{repo.language}]</span>}
                                        </li>
                                    ))}
                                    {repoCount > 3 && (
                                        <li style="color: var(--accent); font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;">+ {repoCount - 3} more repositories...</li>
                                    )}
                                </ul>
                            </div>
                        )}
                    </section>

                    <!-- Right Sidebar -->
                    <aside class="glass-panel" style="animation-delay: 0.3s">
                        <div class="panel-title">Telemetry</div>
                        <div class="stats-grid">
                            <div class="stat-box">
                                <span class="stat-value" id="fps-counter">60</span>
                                <span class="stat-label">FPS</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-value">1.2ms</span>
                                <span class="stat-label">Frame Time</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-value">2000</span>
                                <span class="stat-label">Particles</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-value">14MB</span>
                                <span class="stat-label">Memory Heap</span>
                            </div>
                        </div>
                        
                        <div class="panel-title" style="margin-top: 2rem;">System Log</div>
                        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--text-secondary); background: rgba(0,0,0,0.5); padding: 1rem; border-radius: 8px; height: 200px; overflow-y: hidden;">
                            <div>[SYS] Boot sequence initiated...</div>
                            <div>[SYS] Mounting WorldEngine...</div>
                            <div>[SYS] WebGL context established.</div>
                            <div style="color: var(--accent);">[OK] Deep Space environment ready.</div>
                            <div>[SYS] Hydrating UI components...</div>
                            <div>[SYS] Telemetry stream connected.</div>
                            {repoCount > 0 && <div style="color: var(--accent);">[OK] GitHub metadata fetched.</div>}
                        </div>
                    </aside>
                </div>
            </div>
        </main>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Simulate FPS counter fluctuation for realism
                setInterval(() => {
                    const fps = Math.floor(58 + Math.random() * 3);
                    const fpsEl = document.getElementById('fps-counter');
                    if (fpsEl) fpsEl.innerText = fps.toString();
                }, 500);
            });
        </script>
	</body>
</html>

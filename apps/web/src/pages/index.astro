---
import DxpShell from '../components/shell/DxpShell.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import AboutSection from '../components/profile/AboutSection.astro';
import SkillsSection from '../components/profile/SkillsSection.astro';
import ProjectExplorer from '../components/projects/ProjectExplorer.astro';
import AchievementTimeline from '../components/achievements/AchievementTimeline.astro';
import CertificateGrid from '../components/certificates/CertificateGrid.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<DxpShell>
  <div class="content-wrapper">
    <HeroSection />
    <AboutSection />
    <SkillsSection />
    <ProjectExplorer />
    
    <div class="achievements-certificates-wrapper">
      <AchievementTimeline />
      <CertificateGrid />
    </div>
    
    <ContactSection />
  </div>
</DxpShell>

<style>
  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
  }
  
  .achievements-certificates-wrapper {
    display: flex;
    flex-direction: column;
    padding-bottom: 6rem;
  }
</style>

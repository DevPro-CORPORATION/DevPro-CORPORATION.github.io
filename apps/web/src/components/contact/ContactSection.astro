---
// src/components/contact/ContactSection.astro
import GlowButton from '../ui/GlowButton.astro';
---

<section id="contact" class="contact-section">
  <div class="section-header">
    <h2 class="section-title">COMMUNICATIONS</h2>
    <div class="section-line"></div>
    <div class="section-meta font-mono text-muted">
      <span>[ MODULE: CONTACT ]</span>
      <span>STATUS: LISTENING</span>
    </div>
  </div>
  
  <div class="contact-grid">
    <div class="contact-info">
      <p class="contact-desc text-muted">
        Currently exploring advanced systems engineering, AI/ML, and new product architectures. 
        My communication channels are open for professional opportunities and collaborative R&D.
      </p>
      
      <div class="contact-links font-mono">
        <a href="https://github.com/DevPro-CORPORATION" target="_blank" class="contact-link">
          <span class="link-label">GITHUB:</span>
          <span class="link-value">DevPro-CORPORATION</span>
        </a>
        <a href="mailto:contact@example.com" class="contact-link">
          <span class="link-label">SECURE_MAIL:</span>
          <span class="link-value">Init Connection</span>
        </a>
      </div>
    </div>
    
    <div class="contact-action">
      <div class="action-box">
        <h3 class="box-title font-mono">SYSTEM ACCESS</h3>
        <p class="box-desc text-muted text-sm">Download the comprehensive capability matrix and engineering history.</p>
        <GlowButton href="/resume.pdf" variant="primary" className="w-full" target="_blank">DOWNLOAD RESUME</GlowButton>
      </div>
    </div>
  </div>
  
  <footer class="footer font-mono text-muted">
    <div class="footer-line"></div>
    <div class="footer-content">
      <span>DEVPRO © {new Date().getFullYear()}</span>
      <span>SYSTEM V1.0.0</span>
      <span>ALL SYSTEMS NOMINAL</span>
    </div>
  </footer>
</section>

<style>
  .contact-section {
    padding: 6rem 0 2rem;
    pointer-events: auto;
    position: relative;
    z-index: 5;
  }
  
  .section-header {
    margin-bottom: 4rem;
  }
  
  .section-title {
    font-size: 2.5rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
  }
  
  .section-line {
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--dxp-accent), transparent);
    margin-bottom: 1rem;
  }
  
  .section-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-bottom: 6rem;
  }
  
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 3fr 2fr;
    }
  }
  
  .contact-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }
  
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .contact-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--dxp-border);
  }
  
  @media (min-width: 600px) {
    .contact-link {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  
  .contact-link:hover .link-value {
    color: var(--dxp-accent);
    text-shadow: 0 0 10px var(--dxp-accent-glow);
  }
  
  .link-label {
    color: var(--dxp-text-muted);
    font-size: 0.85rem;
  }
  
  .link-value {
    color: var(--dxp-text);
    transition: all 0.3s ease;
  }
  
  .action-box {
    background: var(--dxp-surface);
    border: 1px solid var(--dxp-border);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  
  .box-title {
    color: var(--dxp-accent);
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }
  
  .box-desc {
    margin-bottom: 2rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  
  .w-full {
    width: 100%;
  }
  
  .footer {
    margin-top: 4rem;
  }
  
  .footer-line {
    height: 1px;
    width: 100%;
    background: var(--dxp-border);
    margin-bottom: 2rem;
  }
  
  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
  }
  
  @media (min-width: 600px) {
    .footer-content {
      flex-direction: row;
    }
  }
</style>

---
// src/components/profile/AboutSection.astro
---

<section id="about" class="about-section">
  <div class="section-header">
    <h2 class="section-title">SYSTEM ARCHITECT</h2>
    <div class="section-line"></div>
    <div class="section-meta font-mono text-muted">
      <span>[ MODULE: IDENTITY ]</span>
      <span>STATUS: ACTIVE</span>
    </div>
  </div>
  
  <div class="about-grid">
    <div class="about-text">
      <p>
        I am a <span class="highlight">Computer Science & AI/ML student</span> and independent builder 
        focused on serious engineering, R&D, and future systems.
      </p>
      <p>
        My work bridges the gap between high-performance software engineering, artificial intelligence, 
        systems architecture, and robotics. I build tools, infrastructure, and intelligent systems that solve complex problems.
      </p>
      <p>
        This portfolio serves as my central command and registry of capabilities. It is a live reflection of my 
        ongoing research and development.
      </p>
    </div>
    
    <div class="about-stats font-mono">
      <div class="stat-item">
        <span class="stat-label">FOCUS</span>
        <span class="stat-value">AI / ML / SYSTEMS</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">BASE</span>
        <span class="stat-value">DEVPRO CORE</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">STATUS</span>
        <span class="stat-value highlight">BUILDING</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 6rem 0;
    pointer-events: auto;
    position: relative;
    z-index: 5;
  }
  
  .section-header {
    margin-bottom: 4rem;
  }
  
  .section-title {
    font-size: 2.5rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
  }
  
  .section-line {
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--dxp-accent), transparent);
    margin-bottom: 1rem;
  }
  
  .section-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  
  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 2fr 1fr;
      align-items: center;
    }
  }
  
  .about-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--dxp-text-muted);
  }
  
  .about-text p {
    margin-bottom: 1.5rem;
  }
  
  .highlight {
    color: var(--dxp-accent);
    font-weight: 600;
  }
  
  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--dxp-surface);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--dxp-border);
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .stat-label {
    font-size: 0.75rem;
    color: var(--dxp-text-muted);
  }
  
  .stat-value {
    font-size: 1.1rem;
    color: var(--dxp-text);
  }
</style>

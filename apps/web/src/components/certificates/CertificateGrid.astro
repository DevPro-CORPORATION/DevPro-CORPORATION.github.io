---
// src/components/certificates/CertificateGrid.astro
const certificates = [
  {
    title: 'Advanced Machine Learning Specialization',
    issuer: 'DeepLearning.AI',
    date: '2024',
    url: '#',
  },
  {
    title: 'Systems Programming in C/C++',
    issuer: 'University',
    date: '2023',
    url: '#',
  },
  {
    title: 'Rust Foundation',
    issuer: 'Linux Foundation',
    date: '2023',
    url: '#',
  }
];
---

<div class="certificates-section">
  <div class="section-meta font-mono text-muted mb-4">
    <span>[ MODULE: CERTIFICATES ]</span>
  </div>
  
  <div class="cert-grid">
    {certificates.map((cert) => (
      <a href={cert.url} class="cert-card" target="_blank" rel="noopener noreferrer">
        <div class="cert-content">
          <div class="cert-date font-mono">{cert.date}</div>
          <h4 class="cert-title">{cert.title}</h4>
          <div class="cert-issuer font-mono text-muted">{cert.issuer}</div>
        </div>
        <div class="cert-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .certificates-section {
    margin-top: 4rem;
  }
  
  .mb-4 {
    margin-bottom: 2rem;
  }
  
  .cert-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 600px) {
    .cert-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }
  
  .cert-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--dxp-surface);
    border: 1px solid var(--dxp-border);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .cert-card:hover {
    border-color: var(--dxp-border-active);
    transform: translateY(-2px);
    background: var(--dxp-surface-strong);
  }
  
  .cert-date {
    font-size: 0.75rem;
    color: var(--dxp-accent);
    margin-bottom: 0.5rem;
  }
  
  .cert-title {
    color: var(--dxp-text);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .cert-issuer {
    font-size: 0.8rem;
  }
  
  .cert-icon {
    color: var(--dxp-text-muted);
    transition: color 0.2s ease;
  }
  
  .cert-card:hover .cert-icon {
    color: var(--dxp-accent);
  }
</style>

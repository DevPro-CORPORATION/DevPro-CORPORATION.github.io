---
// src/components/ui/GlowButton.astro
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  className?: string;
  target?: string;
}

const { href, variant = 'primary', className = '', target } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element 
  href={href} 
  target={target}
  class={`glow-btn btn-${variant} ${className}`}
>
  <span class="btn-content font-mono"><slot /></span>
  <div class="btn-glow"></div>
</Element>

<style>
  .glow-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    border: none;
    outline: none;
  }
  
  .btn-content {
    position: relative;
    z-index: 2;
  }
  
  .btn-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    transform: translate(-50%, -50%) scale(0);
    background: radial-gradient(circle, var(--dxp-accent-glow) 0%, transparent 70%);
    z-index: 1;
    transition: transform 0.5s ease;
    pointer-events: none;
  }
  
  .glow-btn:hover .btn-glow {
    transform: translate(-50%, -50%) scale(1);
  }
  
  /* Variants */
  .btn-primary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--dxp-accent);
    border: 1px solid var(--dxp-accent);
    box-shadow: 0 0 10px var(--dxp-accent-glow) inset;
  }
  
  .btn-primary:hover {
    background: var(--dxp-accent-glow);
    box-shadow: 0 0 20px var(--dxp-accent-glow) inset, 0 0 15px var(--dxp-accent-glow);
    color: #fff;
  }
  
  .btn-secondary {
    background: var(--dxp-surface);
    color: var(--dxp-text);
    border: 1px solid var(--dxp-border);
  }
  
  .btn-secondary:hover {
    border-color: var(--dxp-border-active);
    color: var(--dxp-accent);
  }
  
  .btn-ghost {
    background: transparent;
    color: var(--dxp-text-muted);
    padding: 0.5rem 1rem;
  }
  
  .btn-ghost:hover {
    color: var(--dxp-accent);
    background: rgba(255, 255, 255, 0.03);
  }
</style>

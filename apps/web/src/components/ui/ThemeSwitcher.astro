---
// src/components/ui/ThemeSwitcher.astro
---

<div class="theme-switcher">
  <button id="theme-btn" class="theme-btn" aria-label="Switch Theme">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      <circle cx="12" cy="12" r="4"></circle>
    </svg>
    <span class="font-mono text-xs">THEME</span>
  </button>
  
  <div id="theme-menu" class="theme-menu hidden">
    <button class="theme-option font-mono" data-theme-value="deep-space">Deep Space</button>
    <button class="theme-option font-mono" data-theme-value="stark">Stark</button>
    <button class="theme-option font-mono" data-theme-value="oscorp">Oscorp</button>
    <button class="theme-option font-mono" data-theme-value="spider">Spider</button>
    <button class="theme-option font-mono" data-theme-value="loki">Loki</button>
    <button class="theme-option font-mono" data-theme-value="doom">Doom</button>
  </div>
</div>

<style>
  .theme-switcher {
    position: relative;
    display: inline-block;
  }
  
  .theme-btn {
    background: var(--dxp-surface);
    border: 1px solid var(--dxp-border);
    color: var(--dxp-text-muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .theme-btn:hover {
    color: var(--dxp-accent);
    border-color: var(--dxp-border-active);
    box-shadow: 0 0 10px var(--dxp-accent-glow);
  }
  
  .theme-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--dxp-surface-strong);
    border: 1px solid var(--dxp-border);
    border-radius: 6px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 150px;
    backdrop-filter: blur(10px);
    z-index: 100;
  }
  
  .theme-menu.hidden {
    display: none;
  }
  
  .theme-option {
    background: transparent;
    border: none;
    color: var(--dxp-text-muted);
    padding: 0.5rem;
    text-align: left;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  
  .theme-option:hover, .theme-option.active {
    background: var(--dxp-surface);
    color: var(--dxp-accent);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('theme-btn');
    const menu = document.getElementById('theme-menu');
    const options = document.querySelectorAll('.theme-option');
    
    // Load saved theme
    const savedTheme = localStorage.getItem('dxp-theme') || 'deep-space';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateActiveOption(savedTheme);
    
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
    
    document.addEventListener('click', (e) => {
      if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
        menu?.classList.add('hidden');
      }
    });
    
    options.forEach(opt => {
      opt.addEventListener('click', () => {
        const theme = (opt as HTMLElement).dataset.themeValue;
        if (theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('dxp-theme', theme);
          updateActiveOption(theme);
        }
        menu?.classList.add('hidden');
      });
    });
    
    function updateActiveOption(theme: string) {
      options.forEach(opt => {
        if ((opt as HTMLElement).dataset.themeValue === theme) {
          opt.classList.add('active');
        } else {
          opt.classList.remove('active');
        }
      });
    }
  });
</script>

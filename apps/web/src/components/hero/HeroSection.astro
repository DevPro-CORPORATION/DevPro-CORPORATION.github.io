---
// src/components/hero/HeroSection.astro
import GlowButton from '../ui/GlowButton.astro';
---

<section class="hero-section" id="hero">
  <div class="hero-content">
    <div class="hero-identity">
      <h1 class="hero-title">SOMASUNDARAM</h1>
      <h2 class="hero-subtitle font-mono">/ DEVPRO</h2>
    </div>
    
    <p class="hero-statement">
      Software Engineer • AI/ML • Systems • Robotics
    </p>
    
    <p class="hero-description text-muted">
      I build intelligent systems, developer infrastructure, robotics software, and experimental engineering platforms.
    </p>
    
    <div class="hero-actions">
      <GlowButton href="#projects" variant="primary">EXPLORE PROJECTS</GlowButton>
      <GlowButton href="https://github.com/DevPro-CORPORATION" variant="secondary" target="_blank">VIEW GITHUB</GlowButton>
      <GlowButton href="/resume.pdf" variant="secondary" target="_blank">DOWNLOAD RESUME</GlowButton>
    </div>
  </div>
  
  <div class="hero-telemetry hidden-mobile font-mono">
    <div class="telemetry-block">
      <span class="t-label">SYS.MEM</span>
      <span class="t-value" id="sys-mem">OK</span>
    </div>
    <div class="telemetry-block">
      <span class="t-label">SYS.NET</span>
      <span class="t-value" id="sys-net">12ms</span>
    </div>
    <div class="telemetry-block">
      <span class="t-label">ENV.MODE</span>
      <span class="t-value" id="sys-env">D-SPACE</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: calc(100vh - 150px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding: 2rem 0;
    pointer-events: none;
  }
  
  .hero-content {
    max-width: 800px;
    pointer-events: auto;
  }
  
  .hero-identity {
    margin-bottom: 1.5rem;
  }
  
  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -1px;
    background: linear-gradient(135deg, #ffffff 0%, var(--dxp-text-muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scaleIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .hero-subtitle {
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: var(--dxp-accent);
    margin-top: 0.5rem;
    animation: fadeRight 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }
  
  .hero-statement {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-family: 'JetBrains Mono', monospace;
    color: var(--dxp-text);
    margin-bottom: 1rem;
    animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    opacity: 0;
  }
  
  .hero-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--dxp-text-muted);
    max-width: 600px;
    margin-bottom: 2.5rem;
    animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    opacity: 0;
  }
  
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
    opacity: 0;
  }
  
  .hero-telemetry {
    position: absolute;
    bottom: 2rem;
    right: 0;
    display: flex;
    gap: 2rem;
    opacity: 0.7;
    animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;
    opacity: 0;
  }
  
  .telemetry-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .t-label {
    font-size: 0.7rem;
    color: var(--dxp-text-muted);
  }
  
  .t-value {
    font-size: 0.9rem;
    color: var(--dxp-accent);
  }
  
  @media (max-width: 768px) {
    .hidden-mobile {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dynamic telemetry updates
    const envEl = document.getElementById('sys-env');
    const netEl = document.getElementById('sys-net');
    
    // Listen to theme changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          const theme = document.documentElement.getAttribute('data-theme');
          if (envEl) envEl.innerText = theme ? theme.toUpperCase() : 'UNKNOWN';
        }
      });
    });
    
    observer.observe(document.documentElement, { attributes: true });
    
    // Simulate network fluctuation
    setInterval(() => {
      const ping = Math.floor(10 + Math.random() * 15);
      if (netEl) netEl.innerText = `${ping}ms`;
    }, 2000);
  });
</script>
